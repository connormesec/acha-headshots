# Copy to .env for local development (npm run dev:server reads it via --env-file; never commit .env).
# Everything is optional: with nothing set, every free tool works and admin login / AI help are off.

# Admin login (one shared password). Without it, nobody is admin.
ADMIN_PASSWORD=
# 32+ random characters; without it admins are logged out whenever the server restarts.
SESSION_SECRET=

# AI help for unreadable jersey numbers (admins only). Leave empty to keep it off.
OPENAI_API_KEY=
# openai | mock (free, filename-driven; refused in production) | none
VISION_PROVIDER=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_DAILY_CAP_USD=3
OPENAI_MONTHLY_CAP_USD=10
OPENAI_INPUT_COST_PER_1M=0.40
OPENAI_OUTPUT_COST_PER_1M=1.60

# Where the AI usage log lives (keeps the spending caps across restarts). Outside the deploy folder.
DATA_DIR=./data

# Behind a reverse proxy (Hostinger): 1
TRUST_PROXY=
PORT=8787
